# Query generation can use any OpenAI-compatible endpoint. It is not needed
# when --query-cache-only is used with a complete --query-seed.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
RECOATLAS_QUERY_MODEL=gpt-5.6-luna

# A write token is needed only for the final clean publication.
HF_TOKEN=
